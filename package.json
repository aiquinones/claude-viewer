{
  "name": "claude-viewer",
  "displayName": "Claude Viewer",
  "description": "Inspect your agent's grounding files. View content, size, token estimates.",
  "version": "0.6.1",
  "publisher": "canoq",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/aiquinones/claude-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/aiquinones/claude-viewer/issues"
  },
  "homepage": "https://github.com/aiquinones/claude-viewer#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "ai",
    "configuration"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onUri"
  ],
  "contributes": {
    "configuration": {
      "title": "Claude Viewer",
      "properties": {
        "claudeViewer.budgets.skills.description": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "markdownDescription": "Estimated tokens a skill's name and description should cost. This pair sits in the system prompt on **every request**, whether or not the skill ever runs. Set to `0` to turn the check off."
        },
        "claudeViewer.budgets.skills.content": {
          "type": "number",
          "default": 2000,
          "minimum": 0,
          "markdownDescription": "Estimated tokens a skill's whole `SKILL.md` should cost. This is read **once Claude picks the skill**, not before. Set to `0` to turn the check off."
        },
        "claudeViewer.budgets.skills.overrides": {
          "type": "object",
          "default": {},
          "markdownDescription": "Per-skill budgets, keyed by skill name. Either field may be omitted — overriding one doesn't set the other.\n\n```json\n{ \"dev-feature\": { \"content\": 4000 } }\n```",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "description": { "type": "number", "minimum": 0 },
              "content": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeViewer",
          "title": "Claude Viewer",
          "icon": "resources/activity-bar.svg"
        }
      ]
    },
    "views": {
      "claudeViewer": [
        {
          "id": "claudeViewer.tree",
          "name": "Configuration"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeViewer.launch",
        "title": "Launch Viewer",
        "category": "Claude Viewer"
      },
      {
        "command": "claudeViewer.findSkill",
        "title": "Find Skill…",
        "category": "Claude Viewer"
      },
      {
        "command": "claudeViewer.refresh",
        "title": "Refresh",
        "category": "Claude Viewer",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeViewer.revealNode",
        "title": "Open in Claude Viewer",
        "category": "Claude Viewer"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeViewer.refresh",
          "when": "view == claudeViewer.tree",
          "group": "navigation"
        },
        {
          "command": "claudeViewer.launch",
          "when": "view == claudeViewer.tree",
          "group": "1_panel@1"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeViewer.revealNode",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node build.mjs",
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@tailwindcss/cli": "^4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vscode/vsce": "^3.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.1",
    "lucide-react": "^0.468.0",
    "marked": "^18.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.5.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.4.5",
    "vite": "^8.2.0",
    "zod": "^3.24.1"
  }
}
