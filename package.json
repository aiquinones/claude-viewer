{
  "name": "claude-viewer",
  "displayName": "Claude Viewer",
  "description": "Written by AI as a placeholder; human description coming soon. See which Claude Code skills actually apply in your workspace, and which scope each one won from.",
  "version": "0.6.0",
  "publisher": "canoq",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/aiquinones/claude-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/aiquinones/claude-viewer/issues"
  },
  "homepage": "https://github.com/aiquinones/claude-viewer#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "ai",
    "configuration"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeViewer",
          "title": "Claude Viewer",
          "icon": "resources/activity-bar.svg"
        }
      ]
    },
    "views": {
      "claudeViewer": [
        {
          "id": "claudeViewer.tree",
          "name": "Configuration"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeViewer.open",
        "title": "Claude Viewer: Open"
      },
      {
        "command": "claudeViewer.openSkill",
        "title": "Claude Viewer: Open Skill…"
      },
      {
        "command": "claudeViewer.refresh",
        "title": "Refresh",
        "category": "Claude Viewer",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeViewer.revealNode",
        "title": "Open in Claude Viewer",
        "category": "Claude Viewer"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeViewer.refresh",
          "when": "view == claudeViewer.tree",
          "group": "navigation"
        },
        {
          "command": "claudeViewer.open",
          "when": "view == claudeViewer.tree",
          "group": "1_panel@1"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeViewer.revealNode",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node build.mjs",
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@tailwindcss/cli": "^4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vscode/vsce": "^3.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.1",
    "lucide-react": "^0.468.0",
    "marked": "^18.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.5.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.4.5",
    "vite": "^8.2.0",
    "zod": "^3.24.1"
  }
}
