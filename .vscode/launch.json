{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (canoq-site)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}/../canoq-site",
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "build"
    },
    {
      "name": "Run Extension (no folder)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "build"
    }
  ]
}
